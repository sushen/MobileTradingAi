rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Auth Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'sushen.biswas.aga@gmail.com';
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // User Data: Protect sensitive fields, allow progress updates
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['unlockedPhases']));
    }

    // Phase Metadata: Admin can update seat counts
    match /phases/{phaseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Bookings: Atomic transitions
    match /bookings/{bookingId} {
      allow read, list: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.status == 'pending'
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isOwner(resource.data.userId) && request.resource.data.status == 'cancelled');
    }

    // Referral and Affiliate Stats
    match /referralEvents/{eventId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.referrerId || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == 'system'); // Placeholder for internal triggers if any
    }

    match /affiliateStats/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // Progress persistence for approved users
    match /users/{userId}/progress/{phaseId}/lessons/{lessonId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}